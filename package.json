{
  "name": "dar-tech-os",
  "version": "0.1.0",
  "private": true,
  "description": "Dar Tech OS engineering foundation",
  "license": "UNLICENSED",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "scripts": {
    "build": "npm run db:generate && npm run build:core && npm run build --workspace=@dar-tech/web",
    "build:core": "tsc -b tsconfig.json --pretty false",
    "dev:api": "npm run dev --workspace=@dar-tech/api",
    "dev:web": "npm run dev --workspace=@dar-tech/web",
    "dev:worker": "npm run dev --workspace=@dar-tech/worker",
    "config:check": "tsx infra/scripts/validate-config.ts",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "start:api": "npm run start --workspace=@dar-tech/api",
    "start:web": "npm run start --workspace=@dar-tech/web",
    "start:worker": "npm run start --workspace=@dar-tech/worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "npm run db:generate && tsc -b tsconfig.json --pretty false && npm run typecheck --workspace=@dar-tech/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
