# Local-development examples only. Do not reuse these credentials outside local development.
APP_ENV=development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dartech:dartech@localhost:5432/dartech_os?schema=public
DATABASE_URL_DOCKER=postgresql://dartech:dartech@postgres:5432/dartech_os?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Application
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
