# Local-development examples only. Do not reuse these credentials outside local development.
APP_ENV=development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dartech:dartech@localhost:5433/dartech_os?schema=public
DATABASE_URL_DOCKER=postgresql://dartech:dartech@postgres:5432/dartech_os?schema=public
TEST_DATABASE_URL=postgresql://dartech:dartech@localhost:5433/dartech_os_test?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Local PostgreSQL container only
POSTGRES_USER=dartech
POSTGRES_PASSWORD=dartech
POSTGRES_DB=dartech_os
POSTGRES_PORT=5433

# Application
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
WORKER_HEALTH_FILE=
WORKER_HEARTBEAT_INTERVAL_MS=10000
