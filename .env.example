# Local-development examples only. Do not reuse these credentials outside local development.
APP_ENV=development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dartech:dartech@localhost:5433/dartech_os?schema=public
DATABASE_URL_DOCKER=postgresql://dartech:dartech@postgres:5432/dartech_os?schema=public
TEST_DATABASE_URL=postgresql://dartech:dartech@localhost:5433/dartech_os_test?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Local PostgreSQL container only
POSTGRES_USER=dartech
POSTGRES_PASSWORD=dartech
POSTGRES_DB=dartech_os
POSTGRES_PORT=5433

# Application
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# Provider-neutral authentication. The local adapter is development/test only and opt-in.
AUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback
AUTH_LOCAL_PROVIDER_ENABLED=false
AUTH_LOCAL_IDENTITIES_JSON=[]
AUTH_TRANSACTION_TTL_SECONDS=300
WORKER_HEALTH_FILE=
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_ID=worker-local-1
WORKER_QUEUE=foundation
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=60000
WORKER_JOB_MAX_ATTEMPTS=5
