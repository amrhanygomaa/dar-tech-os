generator client {
  provider               = "prisma-client"
  output                 = "../packages/database/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum QueueJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("queue_job_status")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

enum EmployeeLifecycleStatus {
  INVITED
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED

  @@map("employee_lifecycle_status")
}

enum EventRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("event_risk")
}

enum ScopeType {
  SELF
  ASSIGNED
  TEAM
  DEPARTMENT
  PROJECT
  CUSTOMER
  ORGANIZATION
  EXPLICIT

  @@map("scope_type")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  SUPERSEDED

  @@map("invitation_status")
}

enum SessionClientKind {
  BROWSER

  @@map("session_client_kind")
}

enum ApprovalPolicyOutcome {
  NO_APPROVAL
  SINGLE_APPROVER
  SEQUENTIAL_APPROVAL
  PARALLEL_APPROVAL
  STEP_UP_ONLY
  STEP_UP_AND_APPROVAL

  @@map("approval_policy_outcome")
}

enum ApprovalRequestStatus {
  DRAFT
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXECUTED
  FAILED

  @@map("approval_request_status")
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_step_status")
}

enum ApprovalExecutionState {
  NOT_READY
  READY
  EXECUTING
  SUCCEEDED
  FAILED

  @@map("approval_execution_state")
}

enum ApprovalHistoryCategory {
  REQUESTED
  STEP_APPROVED
  REQUEST_REJECTED
  APPROVAL_COMPLETED
  EXECUTION_STARTED
  EXECUTION_SUCCEEDED
  EXECUTION_FAILED

  @@map("approval_history_category")
}

enum ApprovalApproverSubjectType {
  EMPLOYEE
  ROLE
  RELATIONSHIP

  @@map("approval_approver_subject_type")
}

enum ApprovalSeparationRule {
  NONE
  REQUESTER_DIFFERENT_EMPLOYEE

  @@map("approval_separation_rule")
}

model Organization {
  id               String                 @id @default(uuid()) @db.Uuid
  displayName      String                 @map("display_name") @db.VarChar(160)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees        Employee[]
  userAccounts     UserAccount[]
  ssoIdentities    SSOIdentity[]
  auditEvents      AuditEvent[]
  securityEvents   SecurityEvent[]
  invitations      Invitation[]
  roles            Role[]
  employeeRoles    EmployeeRole[]
  rolePermissions  RolePermission[]
  sessions         Session[]
  approvalRequests ApprovalRequest[]
  approvalSteps    ApprovalStep[]
  approvalHistory  ApprovalHistoryEntry[]

  @@map("organizations")
}

model Employee {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  employeeCode           String                  @map("employee_code") @db.VarChar(64)
  firstName              String                  @map("first_name") @db.VarChar(100)
  lastName               String                  @map("last_name") @db.VarChar(100)
  displayName            String                  @map("display_name") @db.VarChar(160)
  workEmail              String                  @map("work_email") @db.VarChar(320)
  lifecycleStatus        EmployeeLifecycleStatus @default(INVITED) @map("lifecycle_status")
  invitedAt              DateTime                @default(now()) @map("invited_at") @db.Timestamptz(3)
  activatedAt            DateTime?               @map("activated_at") @db.Timestamptz(3)
  suspendedAt            DateTime?               @map("suspended_at") @db.Timestamptz(3)
  offboardingAt          DateTime?               @map("offboarding_at") @db.Timestamptz(3)
  archivedAt             DateTime?               @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount            UserAccount?
  authoredAuditEvents    AuditEvent[]            @relation("AuditEventActor")
  securityEvents         SecurityEvent[]         @relation("SecurityEventActor")
  invitations            Invitation[]            @relation("InvitationEmployee")
  issuedInvitations      Invitation[]            @relation("InvitationIssuer")
  revokedInvitations     Invitation[]            @relation("InvitationRevoker")
  roleAssignments        EmployeeRole[]          @relation("EmployeeRoleEmployee")
  assignedRoles          EmployeeRole[]          @relation("EmployeeRoleAssigner")
  removedRoles           EmployeeRole[]          @relation("EmployeeRoleRemover")
  grantedPermissions     RolePermission[]        @relation("RolePermissionGrantor")
  removedPermissions     RolePermission[]        @relation("RolePermissionRemover")
  sessions               Session[]               @relation("SessionEmployee")
  revokedSessions        Session[]               @relation("SessionRevoker")
  requestedApprovals     ApprovalRequest[]       @relation("ApprovalRequester")
  decidedApprovalSteps   ApprovalStep[]          @relation("ApprovalStepDecider")
  approvalHistoryEntries ApprovalHistoryEntry[]  @relation("ApprovalHistoryActor")

  @@unique([organizationId, id], map: "employees_organization_id_id_key")
  @@unique([organizationId, employeeCode], map: "employees_organization_employee_code_key")
  @@index([organizationId, lifecycleStatus, createdAt], map: "employees_organization_lifecycle_created_at_idx")
  @@index([organizationId, workEmail], map: "employees_organization_work_email_idx")
  @@map("employees")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  key            String           @map("role_key") @db.VarChar(64)
  name           String           @db.VarChar(160)
  normalizedName String           @map("normalized_name") @db.VarChar(160)
  description    String?          @db.VarChar(500)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    EmployeeRole[]
  permissions    RolePermission[]

  @@unique([organizationId, id], map: "roles_organization_id_id_key")
  @@unique([organizationId, key], map: "roles_organization_role_key_key")
  @@unique([organizationId, normalizedName], map: "roles_organization_normalized_name_key")
  @@index([organizationId, archivedAt, name], map: "roles_organization_archived_name_idx")
  @@map("roles")
}

model EmployeeRole {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  employeeId           String       @map("employee_id") @db.Uuid
  roleId               String       @map("role_id") @db.Uuid
  assignedByEmployeeId String       @map("assigned_by_employee_id") @db.Uuid
  assignedAt           DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(3)
  effectiveAt          DateTime     @map("effective_at") @db.Timestamptz(3)
  expiresAt            DateTime?    @map("expires_at") @db.Timestamptz(3)
  removedAt            DateTime?    @map("removed_at") @db.Timestamptz(3)
  removedByEmployeeId  String?      @map("removed_by_employee_id") @db.Uuid
  safeRemovalReason    String?      @map("safe_removal_reason") @db.VarChar(500)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee             Employee     @relation("EmployeeRoleEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  role                 Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  assignedByEmployee   Employee     @relation("EmployeeRoleAssigner", fields: [organizationId, assignedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  removedByEmployee    Employee?    @relation("EmployeeRoleRemover", fields: [organizationId, removedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "employee_roles_organization_id_id_key")
  @@index([organizationId, employeeId, effectiveAt], map: "employee_roles_organization_employee_effective_idx")
  @@index([organizationId, roleId, effectiveAt], map: "employee_roles_organization_role_effective_idx")
  @@index([organizationId, employeeId, roleId, removedAt, expiresAt], map: "employee_roles_effective_lookup_idx")
  @@index([organizationId, assignedByEmployeeId], map: "employee_roles_organization_assigner_idx")
  @@index([organizationId, removedByEmployeeId], map: "employee_roles_organization_remover_idx")
  @@map("employee_roles")
}

model Permission {
  id                       String           @id @default(uuid()) @db.Uuid
  key                      String           @unique(map: "permissions_key_key") @db.VarChar(160)
  domain                   String           @db.VarChar(64)
  resource                 String           @db.VarChar(64)
  action                   String           @db.VarChar(64)
  description              String           @db.VarChar(500)
  riskClassification       EventRisk        @map("risk_classification")
  active                   Boolean          @default(true)
  deprecatedAt             DateTime?        @map("deprecated_at") @db.Timestamptz(3)
  replacementPermissionKey String?          @map("replacement_permission_key") @db.VarChar(160)
  definitionVersion        Int              @map("definition_version")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  replacementPermission    Permission?      @relation("PermissionReplacement", fields: [replacementPermissionKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  replacedPermissions      Permission[]     @relation("PermissionReplacement")
  rolePermissions          RolePermission[]

  @@index([domain, resource, action], map: "permissions_domain_resource_action_idx")
  @@index([active, deprecatedAt], map: "permissions_active_deprecated_idx")
  @@map("permissions")
}

model RolePermission {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  roleId              String       @map("role_id") @db.Uuid
  permissionId        String       @map("permission_id") @db.Uuid
  scopeType           ScopeType    @map("scope_type")
  scopeBindingType    String?      @map("scope_binding_type") @db.VarChar(80)
  scopeBindingId      String?      @map("scope_binding_id") @db.VarChar(128)
  grantedByEmployeeId String       @map("granted_by_employee_id") @db.Uuid
  grantedAt           DateTime     @default(now()) @map("granted_at") @db.Timestamptz(3)
  effectiveAt         DateTime     @map("effective_at") @db.Timestamptz(3)
  expiresAt           DateTime?    @map("expires_at") @db.Timestamptz(3)
  removedAt           DateTime?    @map("removed_at") @db.Timestamptz(3)
  removedByEmployeeId String?      @map("removed_by_employee_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  permission          Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedByEmployee   Employee     @relation("RolePermissionGrantor", fields: [organizationId, grantedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  removedByEmployee   Employee?    @relation("RolePermissionRemover", fields: [organizationId, removedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "role_permissions_organization_id_id_key")
  @@index([organizationId, roleId, permissionId, effectiveAt], map: "role_permissions_role_permission_effective_idx")
  @@index([organizationId, roleId, removedAt, expiresAt], map: "role_permissions_role_effective_lookup_idx")
  @@index([permissionId, removedAt, expiresAt], map: "role_permissions_permission_effective_idx")
  @@index([organizationId, grantedByEmployeeId], map: "role_permissions_organization_grantor_idx")
  @@index([organizationId, removedByEmployeeId], map: "role_permissions_organization_remover_idx")
  @@map("role_permissions")
}

model UserAccount {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  employeeId             String          @unique(map: "user_accounts_employee_id_key") @map("employee_id") @db.Uuid
  authenticationEligible Boolean         @default(false) @map("authentication_eligible")
  activatedAt            DateTime?       @map("activated_at") @db.Timestamptz(3)
  disabledAt             DateTime?       @map("disabled_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee        @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  ssoIdentities          SSOIdentity[]
  securityEvents         SecurityEvent[] @relation("SecurityEventAccount")
  invitations            Invitation[]
  sessions               Session[]

  @@unique([organizationId, id], map: "user_accounts_organization_id_id_key")
  @@unique([organizationId, id, employeeId], map: "user_accounts_organization_id_employee_id_key")
  @@unique([organizationId, employeeId], map: "user_accounts_organization_employee_id_key")
  @@index([organizationId, authenticationEligible], map: "user_accounts_organization_authentication_eligible_idx")
  @@map("user_accounts")
}

model Session {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  userAccountId        String            @map("user_account_id") @db.Uuid
  employeeId           String            @map("employee_id") @db.Uuid
  credentialHash       String            @unique(map: "sessions_credential_hash_key") @map("credential_hash") @db.Char(64)
  clientKind           SessionClientKind @default(BROWSER) @map("client_kind")
  issuedAt             DateTime          @map("issued_at") @db.Timestamptz(3)
  authenticatedAt      DateTime?         @map("authenticated_at") @db.Timestamptz(3)
  lastSeenAt           DateTime          @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt        DateTime          @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime          @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokedByEmployeeId  String?           @map("revoked_by_employee_id") @db.Uuid
  safeRevocationReason String?           @map("safe_revocation_reason") @db.VarChar(500)
  assuranceLevel       String?           @map("assurance_level") @db.VarChar(80)
  lastStepUpAt         DateTime?         @map("last_step_up_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee             Employee          @relation("SessionEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  userAccount          UserAccount       @relation(fields: [organizationId, userAccountId, employeeId], references: [organizationId, id, employeeId], onDelete: Restrict)
  revokedByEmployee    Employee?         @relation("SessionRevoker", fields: [organizationId, revokedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "sessions_organization_id_id_key")
  @@index([organizationId, userAccountId, issuedAt], map: "sessions_organization_account_issued_at_idx")
  @@index([organizationId, employeeId, issuedAt], map: "sessions_organization_employee_issued_at_idx")
  @@index([organizationId, revokedAt, issuedAt], map: "sessions_organization_revoked_issued_at_idx")
  @@index([idleExpiresAt], map: "sessions_idle_expires_at_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expires_at_idx")
  @@map("sessions")
}

model Invitation {
  id                       String           @id @default(uuid()) @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid
  employeeId               String           @map("employee_id") @db.Uuid
  userAccountId            String           @map("user_account_id") @db.Uuid
  invitedEmailNormalized   String           @map("invited_email_normalized") @db.VarChar(320)
  tokenHash                String           @unique(map: "invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status                   InvitationStatus @default(PENDING)
  issuerEmployeeId         String           @map("issuer_employee_id") @db.Uuid
  issuedAt                 DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt                DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt               DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt                DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedByEmployeeId      String?          @map("revoked_by_employee_id") @db.Uuid
  safeRevocationReason     String?          @map("safe_revocation_reason") @db.VarChar(500)
  supersededAt             DateTime?        @map("superseded_at") @db.Timestamptz(3)
  supersededByInvitationId String?          @map("superseded_by_invitation_id") @db.Uuid
  onboardingCompletedAt    DateTime?        @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                 Employee         @relation("InvitationEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  userAccount              UserAccount      @relation(fields: [organizationId, userAccountId], references: [organizationId, id], onDelete: Restrict)
  issuerEmployee           Employee         @relation("InvitationIssuer", fields: [organizationId, issuerEmployeeId], references: [organizationId, id], onDelete: Restrict)
  revokedByEmployee        Employee?        @relation("InvitationRevoker", fields: [organizationId, revokedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  supersededByInvitation   Invitation?      @relation("InvitationSupersession", fields: [organizationId, supersededByInvitationId], references: [organizationId, id], onDelete: Restrict)
  supersededInvitations    Invitation[]     @relation("InvitationSupersession")

  @@unique([organizationId, id], map: "invitations_organization_id_id_key")
  @@index([organizationId, employeeId, issuedAt], map: "invitations_organization_employee_issued_at_idx")
  @@index([organizationId, userAccountId, issuedAt], map: "invitations_organization_account_issued_at_idx")
  @@index([organizationId, status, createdAt], map: "invitations_organization_status_created_at_idx")
  @@index([status, expiresAt], map: "invitations_status_expires_at_idx")
  @@index([organizationId, expiresAt], map: "invitations_organization_expires_at_idx")
  @@index([organizationId, issuerEmployeeId], map: "invitations_organization_issuer_idx")
  @@index([organizationId, revokedByEmployeeId], map: "invitations_organization_revoker_idx")
  @@index([organizationId, supersededByInvitationId], map: "invitations_organization_superseded_by_idx")
  @@map("invitations")
}

model SSOIdentity {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @map("organization_id") @db.Uuid
  userAccountId           String       @map("user_account_id") @db.Uuid
  providerKey             String       @map("provider_key") @db.VarChar(64)
  providerSubject         String       @map("provider_subject") @db.VarChar(255)
  verifiedEmailNormalized String?      @map("verified_email_normalized") @db.VarChar(320)
  linkedAt                DateTime     @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastAuthenticatedAt     DateTime?    @map("last_authenticated_at") @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount             UserAccount  @relation(fields: [organizationId, userAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([providerKey, providerSubject], map: "sso_identities_provider_subject_key")
  @@index([organizationId, userAccountId], map: "sso_identities_organization_account_idx")
  @@index([organizationId, verifiedEmailNormalized], map: "sso_identities_organization_verified_email_idx")
  @@map("sso_identities")
}

model AuditEvent {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  actionKey         String        @map("action_key") @db.VarChar(160)
  actorEmployeeId   String?       @map("actor_employee_id") @db.Uuid
  actorSnapshot     Json          @map("actor_snapshot") @db.JsonB
  targetType        String        @map("target_type") @db.VarChar(80)
  targetId          String        @map("target_id") @db.VarChar(128)
  targetSnapshot    Json?         @map("target_snapshot") @db.JsonB
  requestId         String?       @map("request_id") @db.VarChar(128)
  correlationId     String        @map("correlation_id") @db.VarChar(128)
  sessionReference  String?       @map("session_reference") @db.VarChar(128)
  safeReason        String?       @map("safe_reason") @db.VarChar(1024)
  changeDelta       Json?         @map("change_delta") @db.JsonB
  approvalReference String?       @map("approval_reference") @db.VarChar(128)
  occurredAt        DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  eventVersion      Int           @default(1) @map("event_version")
  integrityVersion  Int           @default(1) @map("integrity_version")
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorEmployee     Employee?     @relation("AuditEventActor", fields: [organizationId, actorEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt, id], map: "audit_events_organization_occurred_at_idx")
  @@index([organizationId, actionKey, occurredAt], map: "audit_events_organization_action_occurred_idx")
  @@index([organizationId, targetType, targetId], map: "audit_events_organization_target_idx")
  @@map("audit_events")
}

model SecurityEvent {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String?       @map("organization_id") @db.Uuid
  eventType        String        @map("event_type") @db.VarChar(160)
  category         String        @db.VarChar(80)
  risk             EventRisk
  outcome          String        @db.VarChar(64)
  actorEmployeeId  String?       @map("actor_employee_id") @db.Uuid
  actorAccountId   String?       @map("actor_account_id") @db.Uuid
  providerKey      String?       @map("provider_key") @db.VarChar(64)
  sessionReference String?       @map("session_reference") @db.VarChar(128)
  actorSnapshot    Json?         @map("actor_snapshot") @db.JsonB
  safeContext      Json?         @map("safe_context") @db.JsonB
  requestId        String?       @map("request_id") @db.VarChar(128)
  correlationId    String        @map("correlation_id") @db.VarChar(128)
  networkContext   Json?         @map("network_context") @db.JsonB
  deviceContext    Json?         @map("device_context") @db.JsonB
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  eventVersion     Int           @default(1) @map("event_version")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorEmployee    Employee?     @relation("SecurityEventActor", fields: [organizationId, actorEmployeeId], references: [organizationId, id], onDelete: Restrict)
  actorAccount     UserAccount?  @relation("SecurityEventAccount", fields: [organizationId, actorAccountId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt, id], map: "security_events_organization_occurred_at_idx")
  @@index([organizationId, eventType, occurredAt], map: "security_events_organization_type_occurred_idx")
  @@index([organizationId, category, risk, outcome], map: "security_events_organization_classification_idx")
  @@index([occurredAt, id], map: "security_events_unresolved_occurred_at_idx")
  @@map("security_events")
}

model ApprovalRequest {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @map("organization_id") @db.Uuid
  requesterEmployeeId      String                 @map("requester_employee_id") @db.Uuid
  requesterSnapshot        Json                   @map("requester_snapshot") @db.JsonB
  actionKey                String                 @map("action_key") @db.VarChar(160)
  resourceType             String                 @map("resource_type") @db.VarChar(80)
  resourceId               String?                @map("resource_id") @db.VarChar(128)
  resourceSnapshot         Json?                  @map("resource_snapshot") @db.JsonB
  serverContextSnapshot    Json                   @map("server_context_snapshot") @db.JsonB
  contextFingerprint       String                 @map("context_fingerprint") @db.Char(64)
  risk                     EventRisk
  policyKey                String                 @map("policy_key") @db.VarChar(160)
  policyVersion            Int                    @map("policy_version")
  policyOutcome            ApprovalPolicyOutcome  @map("policy_outcome")
  policyFingerprint        String                 @map("policy_fingerprint") @db.Char(64)
  stepUpAssuranceLevel     String?                @map("step_up_assurance_level") @db.VarChar(80)
  stepUpMaxAgeSeconds      Int?                   @map("step_up_max_age_seconds")
  status                   ApprovalRequestStatus  @default(PENDING)
  safeRequestReason        String?                @map("safe_request_reason") @db.VarChar(500)
  correlationId            String                 @map("correlation_id") @db.VarChar(128)
  idempotencyDigest        String                 @map("idempotency_digest") @db.Char(64)
  executionState           ApprovalExecutionState @default(NOT_READY) @map("execution_state")
  executionResultReference String?                @map("execution_result_reference") @db.VarChar(128)
  executionFailureCode     String?                @map("execution_failure_code") @db.VarChar(80)
  version                  Int                    @default(1)
  approvedAt               DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectedAt               DateTime?              @map("rejected_at") @db.Timestamptz(3)
  executedAt               DateTime?              @map("executed_at") @db.Timestamptz(3)
  failedAt                 DateTime?              @map("failed_at") @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requesterEmployee        Employee               @relation("ApprovalRequester", fields: [organizationId, requesterEmployeeId], references: [organizationId, id], onDelete: Restrict)
  steps                    ApprovalStep[]
  history                  ApprovalHistoryEntry[]

  @@unique([organizationId, id], map: "approval_requests_organization_id_id_key")
  @@unique([organizationId, idempotencyDigest], map: "approval_requests_organization_idempotency_key")
  @@index([organizationId, status, createdAt], map: "approval_requests_organization_status_created_idx")
  @@index([organizationId, requesterEmployeeId, createdAt], map: "approval_requests_organization_requester_created_idx")
  @@index([organizationId, executionState, updatedAt], map: "approval_requests_organization_execution_updated_idx")
  @@map("approval_requests")
}

model ApprovalStep {
  id                  String                      @id @default(uuid()) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  approvalRequestId   String                      @map("approval_request_id") @db.Uuid
  sequence            Int
  approverSubjectType ApprovalApproverSubjectType @map("approver_subject_type")
  approverSubjectKey  String                      @map("approver_subject_key") @db.VarChar(160)
  separationRule      ApprovalSeparationRule      @default(NONE) @map("separation_rule")
  status              ApprovalStepStatus          @default(PENDING)
  decidedByEmployeeId String?                     @map("decided_by_employee_id") @db.Uuid
  safeDecisionReason  String?                     @map("safe_decision_reason") @db.VarChar(500)
  decidedAt           DateTime?                   @map("decided_at") @db.Timestamptz(3)
  version             Int                         @default(1)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request             ApprovalRequest             @relation(fields: [organizationId, approvalRequestId], references: [organizationId, id], onDelete: Restrict)
  decidedByEmployee   Employee?                   @relation("ApprovalStepDecider", fields: [organizationId, decidedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  history             ApprovalHistoryEntry[]

  @@unique([organizationId, id], map: "approval_steps_organization_id_id_key")
  @@unique([organizationId, approvalRequestId, id], map: "approval_steps_organization_request_id_key")
  @@index([organizationId, approvalRequestId, sequence, status], map: "approval_steps_request_sequence_status_idx")
  @@map("approval_steps")
}

model ApprovalHistoryEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  approvalRequestId String                  @map("approval_request_id") @db.Uuid
  approvalStepId    String?                 @map("approval_step_id") @db.Uuid
  actorEmployeeId   String?                 @map("actor_employee_id") @db.Uuid
  category          ApprovalHistoryCategory
  requestStatus     ApprovalRequestStatus   @map("request_status")
  executionState    ApprovalExecutionState  @map("execution_state")
  safeReason        String?                 @map("safe_reason") @db.VarChar(500)
  correlationId     String                  @map("correlation_id") @db.VarChar(128)
  occurredAt        DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request           ApprovalRequest         @relation(fields: [organizationId, approvalRequestId], references: [organizationId, id], onDelete: Restrict, map: "approval_history_request_fkey")
  step              ApprovalStep?           @relation(fields: [organizationId, approvalRequestId, approvalStepId], references: [organizationId, approvalRequestId, id], onDelete: Restrict, map: "approval_history_step_fkey")
  actorEmployee     Employee?               @relation("ApprovalHistoryActor", fields: [organizationId, actorEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, approvalRequestId, occurredAt, id], map: "approval_history_request_occurred_idx")
  @@index([organizationId, category, occurredAt], map: "approval_history_organization_category_idx")
  @@map("approval_history_entries")
}

model QueueJob {
  id                String         @id @default(uuid()) @db.Uuid
  queue             String         @default("default") @db.VarChar(64)
  name              String         @db.VarChar(160)
  version           Int            @default(1)
  payload           Json           @db.JsonB
  organizationId    String?        @map("organization_id") @db.Uuid
  correlationId     String         @map("correlation_id") @db.VarChar(128)
  causationId       String?        @map("causation_id") @db.VarChar(128)
  deduplicationKey  String?        @map("deduplication_key") @db.VarChar(255)
  deduplicationHash String?        @map("deduplication_hash") @db.Char(64)
  status            QueueJobStatus @default(PENDING)
  availableAt       DateTime       @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount      Int            @default(0) @map("attempt_count")
  maxAttempts       Int            @default(5) @map("max_attempts")
  lockedBy          String?        @map("locked_by") @db.VarChar(128)
  leaseToken        String?        @map("lease_token") @db.Uuid
  lockedAt          DateTime?      @map("locked_at") @db.Timestamptz(3)
  lockExpiresAt     DateTime?      @map("lock_expires_at") @db.Timestamptz(3)
  lastErrorCode     String?        @map("last_error_code") @db.VarChar(128)
  lastErrorMessage  String?        @map("last_error_message") @db.VarChar(2048)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(3)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([queue, deduplicationKey], map: "queue_jobs_queue_deduplication_key")
  @@index([queue, status, availableAt, createdAt], map: "queue_jobs_claim_idx")
  @@index([status, lockExpiresAt], map: "queue_jobs_expired_lease_idx")
  @@index([correlationId], map: "queue_jobs_correlation_id_idx")
  @@index([organizationId, createdAt], map: "queue_jobs_organization_created_at_idx")
  @@map("queue_jobs")
}

model OutboxEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  eventType        String                  @map("event_type") @db.VarChar(200)
  eventVersion     Int                     @default(1) @map("event_version")
  payload          Json                    @db.JsonB
  organizationId   String?                 @map("organization_id") @db.Uuid
  correlationId    String                  @map("correlation_id") @db.VarChar(128)
  causationId      String?                 @map("causation_id") @db.VarChar(128)
  occurredAt       DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  status           OutboxEventStatus       @default(PENDING)
  availableAt      DateTime                @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount     Int                     @default(0) @map("attempt_count")
  maxAttempts      Int                     @default(5) @map("max_attempts")
  lockedBy         String?                 @map("locked_by") @db.VarChar(128)
  leaseToken       String?                 @map("lease_token") @db.Uuid
  lockedAt         DateTime?               @map("locked_at") @db.Timestamptz(3)
  lockExpiresAt    DateTime?               @map("lock_expires_at") @db.Timestamptz(3)
  lastErrorCode    String?                 @map("last_error_code") @db.VarChar(128)
  lastErrorMessage String?                 @map("last_error_message") @db.VarChar(2048)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)
  failedAt         DateTime?               @map("failed_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  consumerReceipts OutboxConsumerReceipt[]

  @@index([status, availableAt, occurredAt], map: "outbox_events_claim_idx")
  @@index([status, lockExpiresAt], map: "outbox_events_expired_lease_idx")
  @@index([correlationId], map: "outbox_events_correlation_id_idx")
  @@index([organizationId, createdAt], map: "outbox_events_organization_created_at_idx")
  @@map("outbox_events")
}

model OutboxConsumerReceipt {
  eventId       String      @map("event_id") @db.Uuid
  consumerName  String      @map("consumer_name") @db.VarChar(160)
  correlationId String      @map("correlation_id") @db.VarChar(128)
  processedAt   DateTime    @default(now()) @map("processed_at") @db.Timestamptz(3)
  event         OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([eventId, consumerName], map: "outbox_consumer_receipts_pkey")
  @@index([consumerName, processedAt], map: "outbox_consumer_receipts_consumer_processed_idx")
  @@map("outbox_consumer_receipts")
}
