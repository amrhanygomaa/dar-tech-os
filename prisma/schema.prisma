generator client {
  provider               = "prisma-client"
  output                 = "../packages/database/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum QueueJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("queue_job_status")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

enum EmployeeLifecycleStatus {
  INVITED
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED

  @@map("employee_lifecycle_status")
}

enum EventRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("event_risk")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  displayName    String          @map("display_name") @db.VarChar(160)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees      Employee[]
  userAccounts   UserAccount[]
  ssoIdentities  SSOIdentity[]
  auditEvents    AuditEvent[]
  securityEvents SecurityEvent[]
  invitations    Invitation[]

  @@map("organizations")
}

model Employee {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  employeeCode        String                  @map("employee_code") @db.VarChar(64)
  firstName           String                  @map("first_name") @db.VarChar(100)
  lastName            String                  @map("last_name") @db.VarChar(100)
  displayName         String                  @map("display_name") @db.VarChar(160)
  workEmail           String                  @map("work_email") @db.VarChar(320)
  lifecycleStatus     EmployeeLifecycleStatus @default(INVITED) @map("lifecycle_status")
  invitedAt           DateTime                @default(now()) @map("invited_at") @db.Timestamptz(3)
  activatedAt         DateTime?               @map("activated_at") @db.Timestamptz(3)
  suspendedAt         DateTime?               @map("suspended_at") @db.Timestamptz(3)
  offboardingAt       DateTime?               @map("offboarding_at") @db.Timestamptz(3)
  archivedAt          DateTime?               @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount         UserAccount?
  authoredAuditEvents AuditEvent[]            @relation("AuditEventActor")
  securityEvents      SecurityEvent[]         @relation("SecurityEventActor")
  invitations         Invitation[]            @relation("InvitationEmployee")
  issuedInvitations   Invitation[]            @relation("InvitationIssuer")
  revokedInvitations  Invitation[]            @relation("InvitationRevoker")

  @@unique([organizationId, id], map: "employees_organization_id_id_key")
  @@unique([organizationId, employeeCode], map: "employees_organization_employee_code_key")
  @@index([organizationId, lifecycleStatus, createdAt], map: "employees_organization_lifecycle_created_at_idx")
  @@index([organizationId, workEmail], map: "employees_organization_work_email_idx")
  @@map("employees")
}

model UserAccount {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  employeeId             String          @unique(map: "user_accounts_employee_id_key") @map("employee_id") @db.Uuid
  authenticationEligible Boolean         @default(false) @map("authentication_eligible")
  activatedAt            DateTime?       @map("activated_at") @db.Timestamptz(3)
  disabledAt             DateTime?       @map("disabled_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee        @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  ssoIdentities          SSOIdentity[]
  securityEvents         SecurityEvent[] @relation("SecurityEventAccount")
  invitations            Invitation[]

  @@unique([organizationId, id], map: "user_accounts_organization_id_id_key")
  @@unique([organizationId, employeeId], map: "user_accounts_organization_employee_id_key")
  @@index([organizationId, authenticationEligible], map: "user_accounts_organization_authentication_eligible_idx")
  @@map("user_accounts")
}

model Invitation {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  employeeId             String           @map("employee_id") @db.Uuid
  userAccountId          String           @map("user_account_id") @db.Uuid
  invitedEmailNormalized String           @map("invited_email_normalized") @db.VarChar(320)
  tokenHash              String           @unique(map: "invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status                 InvitationStatus @default(PENDING)
  issuerEmployeeId       String           @map("issuer_employee_id") @db.Uuid
  issuedAt               DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt              DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt             DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt              DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedByEmployeeId    String?          @map("revoked_by_employee_id") @db.Uuid
  safeRevocationReason   String?          @map("safe_revocation_reason") @db.VarChar(500)
  onboardingCompletedAt  DateTime?        @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee         @relation("InvitationEmployee", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  userAccount            UserAccount      @relation(fields: [organizationId, userAccountId], references: [organizationId, id], onDelete: Restrict)
  issuerEmployee         Employee         @relation("InvitationIssuer", fields: [organizationId, issuerEmployeeId], references: [organizationId, id], onDelete: Restrict)
  revokedByEmployee      Employee?        @relation("InvitationRevoker", fields: [organizationId, revokedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "invitations_organization_id_id_key")
  @@unique([organizationId, employeeId], map: "invitations_organization_employee_id_key")
  @@unique([organizationId, userAccountId], map: "invitations_organization_account_id_key")
  @@index([organizationId, status, createdAt], map: "invitations_organization_status_created_at_idx")
  @@index([status, expiresAt], map: "invitations_status_expires_at_idx")
  @@index([organizationId, expiresAt], map: "invitations_organization_expires_at_idx")
  @@index([organizationId, issuerEmployeeId], map: "invitations_organization_issuer_idx")
  @@index([organizationId, revokedByEmployeeId], map: "invitations_organization_revoker_idx")
  @@map("invitations")
}

model SSOIdentity {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @map("organization_id") @db.Uuid
  userAccountId           String       @map("user_account_id") @db.Uuid
  providerKey             String       @map("provider_key") @db.VarChar(64)
  providerSubject         String       @map("provider_subject") @db.VarChar(255)
  verifiedEmailNormalized String?      @map("verified_email_normalized") @db.VarChar(320)
  linkedAt                DateTime     @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastAuthenticatedAt     DateTime?    @map("last_authenticated_at") @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount             UserAccount  @relation(fields: [organizationId, userAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([providerKey, providerSubject], map: "sso_identities_provider_subject_key")
  @@index([organizationId, userAccountId], map: "sso_identities_organization_account_idx")
  @@index([organizationId, verifiedEmailNormalized], map: "sso_identities_organization_verified_email_idx")
  @@map("sso_identities")
}

model AuditEvent {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  actionKey         String       @map("action_key") @db.VarChar(160)
  actorEmployeeId   String?      @map("actor_employee_id") @db.Uuid
  actorSnapshot     Json         @map("actor_snapshot") @db.JsonB
  targetType        String       @map("target_type") @db.VarChar(80)
  targetId          String       @map("target_id") @db.VarChar(128)
  targetSnapshot    Json?        @map("target_snapshot") @db.JsonB
  requestId         String?      @map("request_id") @db.VarChar(128)
  correlationId     String       @map("correlation_id") @db.VarChar(128)
  sessionReference  String?      @map("session_reference") @db.VarChar(128)
  safeReason        String?      @map("safe_reason") @db.VarChar(1024)
  changeDelta       Json?        @map("change_delta") @db.JsonB
  approvalReference String?      @map("approval_reference") @db.VarChar(128)
  occurredAt        DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  eventVersion      Int          @default(1) @map("event_version")
  integrityVersion  Int          @default(1) @map("integrity_version")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorEmployee     Employee?    @relation("AuditEventActor", fields: [organizationId, actorEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt, id], map: "audit_events_organization_occurred_at_idx")
  @@index([organizationId, actionKey, occurredAt], map: "audit_events_organization_action_occurred_idx")
  @@index([organizationId, targetType, targetId], map: "audit_events_organization_target_idx")
  @@map("audit_events")
}

model SecurityEvent {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String?       @map("organization_id") @db.Uuid
  eventType        String        @map("event_type") @db.VarChar(160)
  category         String        @db.VarChar(80)
  risk             EventRisk
  outcome          String        @db.VarChar(64)
  actorEmployeeId  String?       @map("actor_employee_id") @db.Uuid
  actorAccountId   String?       @map("actor_account_id") @db.Uuid
  providerKey      String?       @map("provider_key") @db.VarChar(64)
  sessionReference String?       @map("session_reference") @db.VarChar(128)
  actorSnapshot    Json?         @map("actor_snapshot") @db.JsonB
  safeContext      Json?         @map("safe_context") @db.JsonB
  requestId        String?       @map("request_id") @db.VarChar(128)
  correlationId    String        @map("correlation_id") @db.VarChar(128)
  networkContext   Json?         @map("network_context") @db.JsonB
  deviceContext    Json?         @map("device_context") @db.JsonB
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  eventVersion     Int           @default(1) @map("event_version")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorEmployee    Employee?     @relation("SecurityEventActor", fields: [organizationId, actorEmployeeId], references: [organizationId, id], onDelete: Restrict)
  actorAccount     UserAccount?  @relation("SecurityEventAccount", fields: [organizationId, actorAccountId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt, id], map: "security_events_organization_occurred_at_idx")
  @@index([organizationId, eventType, occurredAt], map: "security_events_organization_type_occurred_idx")
  @@index([organizationId, category, risk, outcome], map: "security_events_organization_classification_idx")
  @@index([occurredAt, id], map: "security_events_unresolved_occurred_at_idx")
  @@map("security_events")
}

model QueueJob {
  id                String         @id @default(uuid()) @db.Uuid
  queue             String         @default("default") @db.VarChar(64)
  name              String         @db.VarChar(160)
  version           Int            @default(1)
  payload           Json           @db.JsonB
  organizationId    String?        @map("organization_id") @db.Uuid
  correlationId     String         @map("correlation_id") @db.VarChar(128)
  causationId       String?        @map("causation_id") @db.VarChar(128)
  deduplicationKey  String?        @map("deduplication_key") @db.VarChar(255)
  deduplicationHash String?        @map("deduplication_hash") @db.Char(64)
  status            QueueJobStatus @default(PENDING)
  availableAt       DateTime       @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount      Int            @default(0) @map("attempt_count")
  maxAttempts       Int            @default(5) @map("max_attempts")
  lockedBy          String?        @map("locked_by") @db.VarChar(128)
  leaseToken        String?        @map("lease_token") @db.Uuid
  lockedAt          DateTime?      @map("locked_at") @db.Timestamptz(3)
  lockExpiresAt     DateTime?      @map("lock_expires_at") @db.Timestamptz(3)
  lastErrorCode     String?        @map("last_error_code") @db.VarChar(128)
  lastErrorMessage  String?        @map("last_error_message") @db.VarChar(2048)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(3)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([queue, deduplicationKey], map: "queue_jobs_queue_deduplication_key")
  @@index([queue, status, availableAt, createdAt], map: "queue_jobs_claim_idx")
  @@index([status, lockExpiresAt], map: "queue_jobs_expired_lease_idx")
  @@index([correlationId], map: "queue_jobs_correlation_id_idx")
  @@index([organizationId, createdAt], map: "queue_jobs_organization_created_at_idx")
  @@map("queue_jobs")
}

model OutboxEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  eventType        String                  @map("event_type") @db.VarChar(200)
  eventVersion     Int                     @default(1) @map("event_version")
  payload          Json                    @db.JsonB
  organizationId   String?                 @map("organization_id") @db.Uuid
  correlationId    String                  @map("correlation_id") @db.VarChar(128)
  causationId      String?                 @map("causation_id") @db.VarChar(128)
  occurredAt       DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  status           OutboxEventStatus       @default(PENDING)
  availableAt      DateTime                @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount     Int                     @default(0) @map("attempt_count")
  maxAttempts      Int                     @default(5) @map("max_attempts")
  lockedBy         String?                 @map("locked_by") @db.VarChar(128)
  leaseToken       String?                 @map("lease_token") @db.Uuid
  lockedAt         DateTime?               @map("locked_at") @db.Timestamptz(3)
  lockExpiresAt    DateTime?               @map("lock_expires_at") @db.Timestamptz(3)
  lastErrorCode    String?                 @map("last_error_code") @db.VarChar(128)
  lastErrorMessage String?                 @map("last_error_message") @db.VarChar(2048)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)
  failedAt         DateTime?               @map("failed_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  consumerReceipts OutboxConsumerReceipt[]

  @@index([status, availableAt, occurredAt], map: "outbox_events_claim_idx")
  @@index([status, lockExpiresAt], map: "outbox_events_expired_lease_idx")
  @@index([correlationId], map: "outbox_events_correlation_id_idx")
  @@index([organizationId, createdAt], map: "outbox_events_organization_created_at_idx")
  @@map("outbox_events")
}

model OutboxConsumerReceipt {
  eventId       String      @map("event_id") @db.Uuid
  consumerName  String      @map("consumer_name") @db.VarChar(160)
  correlationId String      @map("correlation_id") @db.VarChar(128)
  processedAt   DateTime    @default(now()) @map("processed_at") @db.Timestamptz(3)
  event         OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([eventId, consumerName], map: "outbox_consumer_receipts_pkey")
  @@index([consumerName, processedAt], map: "outbox_consumer_receipts_consumer_processed_idx")
  @@map("outbox_consumer_receipts")
}
