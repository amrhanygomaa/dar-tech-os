{
  "name": "@dar-tech/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "permissions:sync": "node dist/permissions/permission-registry.cli.js sync",
    "permissions:validate": "node dist/permissions/permission-registry.cli.js validate",
    "start": "node dist/main.js",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@dar-tech/config": "0.1.0",
    "@dar-tech/database": "0.1.0",
    "@dar-tech/observability": "0.1.0",
    "@dar-tech/outbox": "0.1.0",
    "@dar-tech/types": "0.1.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
